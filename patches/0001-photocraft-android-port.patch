+# Screen-reader support (accesskit) is desktop-only. eframe rejects the feature
+# combination on Android — `compile_error!("`accesskit` feature is only
+# available with `android-game-activity`")` — because on Android egui's accesskit
+# integration goes through the GameActivity backend, while the Android port
+# packages NativeActivity. Cargo applies features only from target tables whose
+# cfg matches, so desktop keeps accesskit and Android drops it.
+[target.'cfg(not(target_os = "android"))'.dependencies]
+eframe = { workspace = true, features = ["accesskit"] }
