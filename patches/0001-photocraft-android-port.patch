+/// Extra font directories a shell registers for a platform whose fonts the scan cannot find on
+/// its own.
+///
+/// Android: the app's own USB-visible `Fonts` folder, where a user drops a `.ttf` to install it —
+/// the same folder the desktop app sets beside its preferences. One-shot (only the first call
+/// counts) and it must be set before the first scan, so the shell does it before the window opens.
+static EXTRA_FONT_DIRS: std::sync::OnceLock<Vec<std::path::PathBuf>> = std::sync::OnceLock::new();
+
+/// Add directories to [`system_font_dirs`]. See [`EXTRA_FONT_DIRS`].
+pub fn set_extra_font_dirs(dirs: Vec<std::path::PathBuf>) {
+    let _ = EXTRA_FONT_DIRS.set(dirs);
+}
+
 #[cfg(not(target_arch = "wasm32"))]
 pub(crate) fn system_font_dirs() -> Vec<std::path::PathBuf> {
     use std::path::PathBuf;
@@ -578,6 +591,20 @@ pub(crate) fn system_font_dirs() -> Vec<std::path::PathBuf> {
             v.push(h.join(".fonts"));
         }
     }
+    // Android takes the Linux branch above — `cfg!(target_os = "macos")` and `"windows"` are both
+    // false there — and not one of those paths exists on a tablet, so the scan would find no
+    // system fonts at all and every document set in the device's own typeface would fall back.
+    // The system's font folders are these; missing ones are skipped as usual.
+    if cfg!(target_os = "android") {
+        v.push(PathBuf::from("/system/fonts"));
+        v.push(PathBuf::from("/product/fonts"));
+        v.push(PathBuf::from("/system_ext/fonts"));
+        v.push(PathBuf::from("/vendor/fonts"));
+    }
+    // Fonts the shell registered for this platform (Android: the app's own Fonts folder).
+    if let Some(extra) = EXTRA_FONT_DIRS.get() {
+        v.extend(extra.iter().cloned());
+    }
     v
 }
 
